# LIFEOS Environment Variables Configuration

# Database: SQLite local file
DATABASE_URL="file:./lifeos.db"

# Authentication: Secure JWT / Session secret
JWT_SECRET="lifeos-jwt-secret-replace-with-secure-random-string-in-production"

# AI Integration (Optional - Fallback simulator provided if unset)
GEMINI_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
